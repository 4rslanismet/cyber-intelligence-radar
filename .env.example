# Cyber Intelligence Radar - example configuration.
# Copy this file to .env and fill in the values you need:
#   cp .env.example .env
# Every setting has a safe default unless marked REQUIRED. Run
# `cyber-radar doctor` after editing to validate your configuration.

# =============================================================================
# Database (REQUIRED)
# =============================================================================
# `cyber-radar db init` will create the schema; you still need a running
# PostgreSQL server and a database/role for it to connect to.
DATABASE_URL=postgresql://cyber_radar:CHANGE_ME@localhost:5432/cyber_radar

# =============================================================================
# LLM (REQUIRED - Google Gemini)
# =============================================================================
# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Cheap/fast model for the relevance filter.
RELEVANCE_MODEL=gemini-3.8-flash
# Stronger model for deep analysis.
ANALYSIS_MODEL=gemini-3.8-flash
# Confirm your account's actual free-tier daily/per-minute limits at
# https://ai.google.dev/gemini-api/docs/rate-limits and set a value BELOW
# it with margin - a limit set above your real quota causes 429 errors on
# the very first run.
GEMINI_DAILY_REQUEST_LIMIT=18
# How many times per day the radar runs (see docs/DEPLOYMENT.md) - the
# daily quota above is split evenly across runs.
GEMINI_RUNS_PER_DAY=2
GEMINI_MIN_CALL_INTERVAL_SECONDS=2.0
# Independent LLM budget pools so academic and news analysis never starve
# each other (see docs/ARCHITECTURE.md "budget isolation").
NEWS_DAILY_LLM_BUDGET=9
PAPERS_DAILY_LLM_BUDGET=9

# =============================================================================
# News sources
# =============================================================================
# Comma-separated RSS/Atom feed URLs. Leave empty to run with academic
# sources only.
NEWS_FEEDS=

# =============================================================================
# Academic sources
# =============================================================================
# Search keywords (comma-separated) - each is queried independently
# against OpenAlex/arXiv/Semantic Scholar/Crossref (no key required for
# any of these).
KEYWORDS=cybersecurity,threat intelligence
# Optional but recommended: identifies you to OpenAlex/Crossref's
# "polite pool" for better rate limits - no account needed, just an email.
CONTACT_EMAIL=
# Optional: raises your Semantic Scholar rate limit - request one at
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
# DBLP has no key but is commonly bot-blocked from cloud hosts - defaults
# off; try enabling it if your network isn't blocked.
DBLP_ENABLED=false

# =============================================================================
# Telegram (OPTIONAL - digest is always written locally regardless)
# =============================================================================
# Leave both empty to run in local-output-only mode. See docs/QUICKSTART.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =============================================================================
# Google Drive (OPTIONAL - disabled by default, opt-in)
# =============================================================================
GDRIVE_ENABLED=false
# From a Google Cloud Console OAuth client (type: "TVs and Limited Input
# devices") - only needed if GDRIVE_ENABLED=true.
GDRIVE_OAUTH_CLIENT_ID=
GDRIVE_OAUTH_CLIENT_SECRET=
# Leave empty to auto-create a folder named GDRIVE_ROOT_FOLDER_NAME.
GDRIVE_ROOT_FOLDER_ID=
GDRIVE_ROOT_FOLDER_NAME=Cyber Intelligence Radar
# 'direct' = simple synchronous upload at the end of each run. 'queued' =
# persistent queue + a separate worker (see docs/ARCHITECTURE.md) -
# recommended if you enable Drive sync on a resource-constrained host.
GDRIVE_SYNC_MODE=direct
GDRIVE_DAILY_UPLOAD_BUDGET_GB=5
GDRIVE_DAILY_FILE_LIMIT=500
GDRIVE_WORKER_MAX_RUNTIME_MINUTES=60
GDRIVE_RESUMABLE_THRESHOLD_MB=5
GDRIVE_UPLOAD_CHUNK_MB=8
GDRIVE_MAX_RETRIES_PER_FILE=5
GDRIVE_VERIFY_MD5_MAX_MB=200

# =============================================================================
# Retention (local disk cleanup - only applies to files already uploaded
# to Drive; if Drive is disabled, nothing is ever deleted)
# =============================================================================
LOCAL_RETENTION_DAYS=2
PDF_CACHE_RETENTION_DAYS=0
NOTEBOOKLM_PERIOD_DAYS=2
NOTEBOOKLM_PDF_VALUE_THRESHOLD=14

# =============================================================================
# Research profiles
# =============================================================================
# Which profiles/<id>.yaml files are active, in order. Default
# "daily_cyber" alone reproduces the plain KEYWORDS-driven behavior above.
# See docs/PROFILES.md and profiles/examples/*.yaml.
ACTIVE_RESEARCH_PROFILES=daily_cyber
# Optional: assign up to two profiles their own scored digest section
# (see docs/PROFILES.md "Research Profile A/B"). Leave both empty to
# disable this feature entirely (default).
RESEARCH_PROFILE_A_ID=
RESEARCH_PROFILE_B_ID=
RESEARCH_PROFILE_A_TARGET=5
RESEARCH_PROFILE_B_TARGET=5
RESEARCH_PROFILE_A_LLM_BUDGET=3
RESEARCH_PROFILE_B_LLM_BUDGET=3
# Field names your profile's extraction_schema.digest_bridge uses - only
# change these if you write a profile with different field names than
# the shipped examples.
RESEARCH_PROFILE_A_SCORE_FIELD=relevance_score
RESEARCH_PROFILE_A_REASON_FIELD=why_relevant
RESEARCH_PROFILE_A_DIMS_FIELD=relevance_dimensions
RESEARCH_PROFILE_B_SCORE_FIELD=relevance_score
RESEARCH_PROFILE_B_REASON_FIELD=why_relevant
RESEARCH_PROFILE_B_DIMS_FIELD=relevance_dimensions

# =============================================================================
# Operational quotas (news digest categories - see docs/ARCHITECTURE.md)
# =============================================================================
# Legacy shared default - kept for backward compatibility; the 4 configs
# below default to this value if not set individually.
OPERATIONAL_CATEGORY_TARGET=5
OPERATIONAL_ACTION_TARGET=5
OPERATIONAL_HUNT_TARGET=5
OPERATIONAL_TUTORIAL_TARGET=5
OPERATIONAL_AWARENESS_TARGET=5

# =============================================================================
# Academic quotas
# =============================================================================
ACADEMIC_CURRENT_TARGET=5
ACADEMIC_TIMELINE_TARGET=5
ACADEMIC_CLASSIC_TARGET=1
ACADEMIC_HISTORICAL_TARGET=5

# =============================================================================
# Relevance thresholds
# =============================================================================
RELEVANCE_THRESHOLD_HIGH=0.75
RELEVANCE_THRESHOLD_LOW=0.4
# Extra priority weight for news mentioning these vendors/products
# (comma-separated, case-insensitive) - tune to your own environment.
HIGH_VALUE_VENDOR_KEYWORDS=Microsoft,Windows,Active Directory,Linux,Cisco,Fortinet,Palo Alto,Ivanti,Citrix,VMware,Splunk,Elastic,Wazuh,SIEM,EDR,XDR,VPN,Firewall,WAF,Identity

# =============================================================================
# Health checks / anomaly detection
# =============================================================================
SOURCE_ANOMALY_DROP_THRESHOLD=0.4
SOURCE_CONSECUTIVE_ZERO_ALERT_COUNT=3
ANOMALY_MIN_RUN_GAP_HOURS=6

# =============================================================================
# Logging
# =============================================================================
COLLECTOR_ERROR_LOG_ENABLED=false
